# Copy these deployment-specific values into Coolify's runtime environment.
# Generate three separate secrets with:
# openssl rand -hex 32
POSTGRES_PASSWORD=
REDIS_PASSWORD=
INTERNAL_API_SECRET=
APP_ORIGIN=

# The committed runner environment selects OpenAI by default, so both values
# below are required. To use Gemini instead, change deploy/env/pbn.env and set
# GOOGLE_API_KEY and GOOGLE_IMAGE_MODEL in Coolify instead.
OPENAI_API_KEY=
OPENAI_IMAGE_MODEL=
