# Copy these values into Coolify's runtime environment variables.
# Each blank secret must be replaced; generate three separate values with:
# openssl rand -hex 32
POSTGRES_PASSWORD=
REDIS_PASSWORD=
INTERNAL_API_SECRET=
APP_ORIGIN=https://pbn.zichka.com

# Configure at least one provider with BOTH its key and image model.
AI_SIMPLIFICATION_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_IMAGE_MODEL=
OPENAI_IMAGE_QUALITY=low
OPENAI_IMAGE_MODERATION=low
GOOGLE_API_KEY=
GOOGLE_IMAGE_MODEL=
AI_REQUEST_TIMEOUT_SECONDS=180
AI_MAX_RETRIES=2
PBN_OPTION_MAX_ATTEMPTS=5

# Tune only after measuring peak memory and processing time on your server.
WORKER_CONCURRENCY=1
PBN_NUM_THREADS=1
QUEUE_MAX_SIZE=20
MAX_ACTIVE_PROJECTS_PER_CLIENT=2
