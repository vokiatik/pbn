PROJECTS_DIR=/storage/projects
AI_SIMPLIFICATION_PROVIDER=openai
OPENAI_API_KEY=${OPENAI_API_KEY:-}
OPENAI_IMAGE_MODEL=${OPENAI_IMAGE_MODEL:-}
OPENAI_IMAGE_QUALITY=low
OPENAI_IMAGE_MODERATION=low
GOOGLE_API_KEY=${GOOGLE_API_KEY:-}
GOOGLE_IMAGE_MODEL=${GOOGLE_IMAGE_MODEL:-}
AI_REQUEST_TIMEOUT_SECONDS=180
AI_MAX_RETRIES=2
PBN_OPTION_MAX_ATTEMPTS=5
PBN_DEBUG_IMAGES=${PBN_DEBUG_IMAGES:-0}

# Keep numerical libraries to one thread unless server capacity has been measured.
OMP_NUM_THREADS=1
OPENBLAS_NUM_THREADS=1
MKL_NUM_THREADS=1
